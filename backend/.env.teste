# Configuracao usada por "npm test". Aponta para um banco separado, para que
# os testes nunca apaguem os dados de desenvolvimento.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_USER=calcule
DB_PASSWORD=calcule
DB_NAME=calcule_certo_teste

JWT_SEGREDO=segredo-usado-apenas-nos-testes
JWT_EXPIRACAO=1h

# Vazio de proposito: sem isto, o SMTP do .env seria usado e os testes
# mandariam e-mails de verdade. Assim eles ficam na caixa de saida de teste.
SMTP_HOST=
