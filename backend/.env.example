# Copie este arquivo para .env  ->  cp .env.example .env
PORTA=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=calcule
DB_PASSWORD=calcule
DB_NAME=calcule_certo

# Em producao troque por um valor longo e aleatorio (a API nao sobe sem isso).
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=troque-este-segredo-em-producao
JWT_EXPIRACAO=8h

# Fuso das datas impressas nos relatorios em PDF.
FUSO_HORARIO=America/Rio_Branco

# Endereco do front-end, usado no link do e-mail de recuperacao de senha.
URL_FRONT=http://localhost:5173

# Servidor de e-mail. Deixe SMTP_HOST vazio em desenvolvimento: o e-mail nao
# sai e o link aparece no terminal da API.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=Calcule Certo <nao-responda@calculecerto.com>
